# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'http' for cloud container deployments.
# =============================================================================
MCP_TRANSPORT_TYPE=http
PORT=3000
HOST=0.0.0.0
ENABLE_CORS=true

# NitroStack Cloud Deployment Configuration
NITROCLOUD_URL=https://aegis-protocol-6a-kernel-guardians-amrita-university-coimbatore.app.nitrocloud.ai
NITROCLOUD_API_KEY=nsk_live_...
