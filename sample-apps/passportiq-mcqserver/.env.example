# PassportIQ — runtime configuration.
#
# Copy to `.env` for local work. On NitroCloud set these in the project's
# Environment / Secrets panel instead (they are AES-256 encrypted at rest).

# ---------------------------------------------------------------------------
# Transport — THE TWO VARS THAT DECIDE WHETHER ANYTHING LISTENS
# ---------------------------------------------------------------------------
# NitroStack picks its transport from NODE_ENV inside NitroStackServer.start():
#   unset | development | dev  -> stdio ONLY. No HTTP port. No /console.
#   anything else              -> dual stdio + HTTP on PORT/HOST.
# This is not configurable from nitrostack.config.ts.
NODE_ENV=production

# The HTTP transport defaults to host `localhost`. Inside a container that binds
# the loopback interface only, so the platform health probe cannot reach it and
# the deploy fails readiness. Always 0.0.0.0 on NitroCloud.
HOST=0.0.0.0

# NitroCloud injects PORT. 8080 is the local default.
PORT=8080

# ---------------------------------------------------------------------------
# Autopilot — the autonomous sweep loop
# ---------------------------------------------------------------------------
# true|1  -> arm the background loop at boot
# false|0 -> on-demand only (manual sweep from the console still works)
# unset   -> armed when NODE_ENV=production
PASSPORTIQ_AUTOPILOT=true

# Seconds between sweeps. Clamped to a minimum of 10.
PASSPORTIQ_AUTOPILOT_INTERVAL=45

# Applications investigated per sweep. Clamped to 1..9.
PASSPORTIQ_AUTOPILOT_BATCH=3

# ---------------------------------------------------------------------------
# LLM planner (optional)
# ---------------------------------------------------------------------------
# With a key the agent plans with an LLM and narrates its findings in prose.
# Without one it falls back to the deterministic policy planner — every tool still
# runs, every rule still fires, and the demo still works end to end. The fallback
# is deliberate: a hackathon network that eats outbound HTTPS must not brick the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternatives, read only if OPENAI_API_KEY is absent.
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
