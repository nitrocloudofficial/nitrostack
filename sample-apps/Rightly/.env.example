# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Gemini API
# Get your API key from: https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Service
# Get your API key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here

# Google Custom Search API
# Get your API key from: https://console.cloud.google.com/
# Create a Custom Search Engine at: https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_search_engine_id_here

# Server Transport Configuration (Optional)
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
