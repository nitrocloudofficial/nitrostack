# 🛡️ Project Aegis — Environment Configuration

# Primary MCP Server & Web UI Port
PORT=3000

# Server Binding Host (0.0.0.0 required for Docker / Cloud Ingress)
HOST=0.0.0.0

# Optional: PostgreSQL Database Connection
# If omitted, Aegis operates using the built-in in-memory core-banking ledger.
# DATABASE_URL=postgresql://aegis_user:aegis_pass@localhost:5432/aegis_db

# Internal Core Banking API Port
BANK_API_PORT=3001

# NitroStack Framework Mode
NITROSTACK_APP_MODE=OPENAI
