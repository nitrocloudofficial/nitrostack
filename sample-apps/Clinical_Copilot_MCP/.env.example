# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# Database Configuration (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/"
DATABASE_NAME=clinical_copilot

# Supabase Storage & Auth Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET=medical-reports

# LLM Providers Configuration (Primary: Gemini 2.5, Fallback: Groq Llama 3.3)
GEMINI_API_KEY="your-gemini-api-key"
GROK_API_KEY="gsk_your_groq_api_key"

# Vector Database (Pinecone)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX=clinical-copilot

# Server Transport Configuration (Optional)
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
