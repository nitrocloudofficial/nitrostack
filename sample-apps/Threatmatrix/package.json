    "cloudconvert": "^3.0.0",
    "dotenv": "^16.4.7",
    "groq-sdk": "^1.4.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.4",
