# HealthBridge MCP — Environment Configuration
# Copy to .env and fill in your values before running locally.
# NitroCloud injects these automatically from your project settings.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── NitroStack / NitroCloud (auto-injected on NitroCloud, fill for local) ─────
# NITROSTACK_API_KEY=your_api_key_here
# NITROSTACK_SERVER_NAME=healthbridge-mcp

# ── Auth (optional — NitroStack built-in auth) ────────────────────────────────
# AUTH_MODE=api_key        # api_key | oauth | none
# API_KEY_HEADER=X-API-Key
# API_KEY=your_secret_key
