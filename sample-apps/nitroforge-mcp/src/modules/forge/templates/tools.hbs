import { ControllerDecorator as Controller, ToolDecorator as Tool, {{#if anyWidget}}Widget, {{/if}}{{#if anyCache}}Cache, {{/if}}z } from '@nitrostack/core';
import type { ExecutionContext } from '@nitrostack/core';
import { {{serviceClassName}} } from './{{moduleName}}.service.js';

/**
 * Generated by NitroForge — thin tools, fat service. Every inputSchema
 * below was derived from the EndpointGraph via this tool's `composes`
 * array; the planning model never saw or supplied field names.
 */
@Controller()
export class {{toolsClassName}} {
  constructor(private readonly {{serviceParamName}}: {{serviceClassName}}) {}

{{#each tools}}
  @Tool({
    name: {{{this.nameJSON}}},
    description: {{{this.descriptionJSON}}},
    inputSchema: {{{this.inputSchemaSource}}},
    invocation: {
      invoking: {{{this.invokingJSON}}},
      invoked: {{{this.invokedJSON}}},
    },
    examples: {
      request: {{{this.requestExampleJSON}}},
      response: {{{this.responseExampleJSON}}},
    },
  })
{{#if this.widgetArchetype}}
  @Widget({{{this.widgetArchetypeJSON}}})
{{/if}}
{{#if this.cacheTtl}}
  @Cache({ ttl: {{this.cacheTtl}} })
{{/if}}
  async {{this.methodName}}(input: any, ctx: ExecutionContext) {
    ctx.logger.info({{{this.nameJSON}}} + ' called', { input });
    return this.{{../serviceParamName}}.{{this.methodName}}(input);
  }

{{/each}}
}
