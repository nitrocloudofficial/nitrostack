import { McpApp, Module, ConfigModule } from '@nitrostack/core';
{{#each modules}}
import { {{this.className}} } from './modules/{{this.name}}/{{this.name}}.module.js';
{{/each}}

/**
 * Generated by NitroForge's emitter — deterministic template expansion,
 * no model involved. Same IR in, byte-identical output out.
 */
@McpApp({
  module: AppModule,
  server: {
    name: {{{serverNameJSON}}},
    version: {{{serverVersionJSON}}},
  },
  logging: {
    level: 'info',
  },
})
@Module({
  name: 'app',
  description: {{{serverDescriptionJSON}}},
  imports: [ConfigModule.forRoot(){{#each modules}}, {{this.className}}{{/each}}],
  providers: [],
})
export class AppModule {}
