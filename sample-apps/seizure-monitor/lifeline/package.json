{
  "name": "Lifeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lifeline: An agentic AI MCP server that triages emergencies, finds the best-equipped nearby hospital with available beds, and enables instant bed reservation.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "author": "Team Kanya Rashi",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
