{
  "name": "decision-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DecisionOS - AI Decision Operating System",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "npm run widget:build && nitrostack-cli build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "widget:build": "npm --prefix src/widgets run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "Team Tuff Knuckles",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
