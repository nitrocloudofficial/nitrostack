{
  "name": "nitroproj",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NitroProj Medical Triage MCP Server & Frontend",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "nitrostack-cli dev",
    "dev:frontend": "PORT=3005 node frontend/server.js",
    "serve:frontend": "PORT=3005 node frontend/server.js",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.31",
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "@supabase/supabase-js": "^2.108.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^7.0.47",
    "dotenv": "^16.3.1",
    "lucide-react": "^1.28.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": ""
}