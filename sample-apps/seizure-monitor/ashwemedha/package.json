{
  "name": "nitrostack-market-signal",
  "version": "1.0.0",
  "description": "Multi-agent market signal MCP server — Scout, Analyst, Skeptic pipeline",
  "type": "module",
  "scripts": {
    "build": "npm install --prefix market-signal-mcp && npm run build --prefix market-signal-mcp",
    "start": "npm run start:prod --prefix market-signal-mcp",
    "dev:skeptic": "tsx server/skeptic-server.ts",
    "dev:analyst": "tsx server/analyst-server.ts",
    "test:skeptic": "tsx test/skeptic-standalone.ts",
    "test:analyst": "tsx test/analyst-standalone.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
