{
  "name": "downtime-arbiter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent MCP server negotiating machine downtime between Production and Maintenance agents using causal P-F curve risk reasoning",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "typecheck": "tsc --noEmit",
    "eval": "npm run build && node dist/evals/run-downtimearbiter-eval.js",
    "agent-demo": "tsx agents/orchestrator.ts MACH_001",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nitrostack/core": "^1.0.13",
    "dotenv": "^16.3.1",
    "groq-sdk": "^1.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.14",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "author": "Codeblood",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
