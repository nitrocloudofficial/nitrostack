{
  "manifest_version": 3,
  "name": "TrustLayer AI",
  "version": "1.0.0",
  "description": "AI transaction copilot for safe peer-to-peer commerce",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.olx.in/*", "*://*.facebook.com/*", "*://localhost/*", "*://127.0.0.1/*", "*://*.trustlayer.ai/*", "file:///*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
