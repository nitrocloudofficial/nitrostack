import { Injectable } from '@nitrostack/core';

/**
 * Generated by NitroForge. One method per tool, calling the tool's primary
 * endpoint against the source API's base URL. Path params are substituted
 * from `input`, query params appended when present, and body sent for
 * write methods.
 */
@Injectable()
export class {{serviceClassName}} {
  private readonly baseUrl = {{{baseUrlJSON}}};
{{#if authHeaderName}}
  private readonly authHeaderName = {{{authHeaderNameJSON}}};
{{/if}}

{{#each methods}}
  async {{this.methodName}}(input: any): Promise<any> {
    const path = `{{{this.pathTemplate}}}`;
    const url = new URL(this.baseUrl + path);
{{#each this.queryParams}}
    if (input.{{this}} !== undefined) url.searchParams.set('{{this}}', String(input.{{this}}));
{{/each}}

    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
{{#if ../authHeaderName}}
    if (process.env.API_KEY) headers[this.authHeaderName] = process.env.API_KEY;
{{/if}}

    const response = await fetch(url.toString(), {
      method: {{{this.httpMethodJSON}}},
      headers,
{{#if this.hasBody}}
      body: JSON.stringify({
{{#each this.bodyFields}}
        {{this}}: input.{{this}},
{{/each}}
      }),
{{/if}}
    });

    if (!response.ok) {
      throw new Error(`{{this.methodName}} failed: ${response.status} ${response.statusText}`);
    }
    return response.json();
  }

{{/each}}
}
