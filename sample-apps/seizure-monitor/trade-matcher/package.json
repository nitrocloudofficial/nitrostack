{
  "name": "trade-matcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trade Matcher is an MCP-powered agent built on NitroStack that automates financial trade reconcilation under T+1 pressure by intelligently matching multi-system trade records and generating plain-English explainations to instantly seperate harmless formatting noise from genuine operational errors",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "openai": "^6.49.0",
    "p-limit": "^7.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "author": "Team 404 : Sleep Not Found",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
