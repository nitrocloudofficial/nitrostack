# SentinelPay AI — environment template (no secrets committed)
# Copy to .env and fill in values for your environment.
# §12.4 / §17.1 — variable names below match exactly what src/ reads via
# process.env; nothing here is aspirational or unused.

# Runtime (§17.1)
NODE_ENV=development
LOG_LEVEL=info

# Authentication (§11.3, §12.1, §12.4 — see src/security/auth.ts).
# Required. The server fails closed (rejects every tool call) if unset.
MCP_AUTH_TOKEN=

# Local development only (src/security/auth.ts). NitroStudio and other MCP
# clients don't forward a real Authorization header into ExecutionContext
# in this SDK version (see index.ts gap #2), so authenticate() has no
# header to check when testing tools locally. Set to "true" in your own
# untracked .env to let requests with no Authorization header through as
# a dev principal. Leave unset everywhere else — this must never be
# "true" in a deployed environment.
MCP_AUTH_ALLOW_LOCAL_BYPASS=

# Platform credential, if your deployed NitroStack environment requires one
# (§17.1). Not read by this codebase directly — passed through to the
# NitroStack SDK scaffold if/when needed.
NITROSTACK_API_KEY=

# Risk engine weights (§5.7, §17.2). Prototype heuristic weights — locked
# spec defaults shown; override only to experiment, never to imply a
# validated fraud-probability model.
BENEFICIARY_MISMATCH_WEIGHT=35
AMOUNT_ANOMALY_WEIGHT=32
POLICY_VIOLATION_WEIGHT=20
RISK_SCORE_CAP=100

# Policy engine (§5.6, §17.1). INR amount above which human approval is
# required. Defaults to the fixture-configured value (data/policies.json,
# currently 500000) if unset.
APPROVAL_THRESHOLD=500000
