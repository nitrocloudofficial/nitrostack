# NitroStack Configuration
# Copy this file to .env for local development. Do not commit .env or real
# secrets. Configure production values in NitroCloud and Cloud Run secret stores.
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Seer ML service. Use an HTTPS URL outside local development; HTTP is allowed
# only for localhost local development.
ML_SERVICE_BASE_URL=http://127.0.0.1:8080
# Required in both the MCP server and ML service. Use a long random value.
ML_SERVICE_API_KEY=replace-with-a-long-random-secret
ML_SERVICE_TIMEOUT_MS=120000
# Retry one failed connection or 5xx response after a short backoff. Set to 0
# to disable retries; timeouts and client errors are never retried.
ML_SERVICE_MAX_RETRIES=1

# Dedicated HMAC secret for stateless, 15-minute analysis-plan approval tokens.
# MCP server only: generate a unique value of at least 32 characters; do not
# reuse ML_SERVICE_API_KEY.
ANALYSIS_PLAN_TOKEN_SECRET=replace-with-a-different-long-random-secret

# CSV profiling limits enforced by the ML service.
ML_PROFILE_MAX_CSV_BYTES=5242880
ML_PROFILE_MAX_CSV_ROWS=20000
ML_PROFILE_MAX_CSV_COLUMNS=50
ML_PROFILE_MAX_CATEGORICAL_VALUES=50
ML_PROFILE_SAMPLE_ROWS=10

# Analysis limits enforced by both the MCP server and ML service.
ML_MAX_ENCODED_FEATURES=500
ML_MAX_PREDICTION_ROWS=10
ML_MIN_USABLE_ROWS=20
# Warn before fitting when the usable target rows are below this value.
ML_SMALL_DATASET_WARNING_ROWS=100
ML_MAX_CLASSIFICATION_CLASSES=10
# Warn when the least frequent target class is below this percentage.
ML_CLASS_IMBALANCE_THRESHOLD_PERCENT=20

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
