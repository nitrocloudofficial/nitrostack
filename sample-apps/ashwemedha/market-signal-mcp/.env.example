# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# ─── Market Signal MCP — Project-specific API Keys ────────────────────────────
# Primary News API (https://newsapi.org - 500 req/day free tier)
# If not set, server automatically falls back to GNews or seed-news.json
NEWSAPI_KEY=your_newsapi_key_here

# Secondary News API (https://gnews.io - 100 req/day free tier)
GNEWS_API_KEY=your_gnews_api_key_here

# Alpha Vantage — free market data API (Person 2 uses this for price/volume)
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Crypto Data — CoinGecko public API (no key needed for basic endpoints)
# COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Optional Reddit Social Scanner credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=nitrostack-scout/1.0

# ─── Phase 2: Video Prediction Intelligence ───────────────────────────────────
# ONE key covers ALL of Phase 2 (STT transcription + LLM claim extraction + narrative generation)
# Groq — free tier, no credit card. Sign up at https://console.groq.com/
# Models used: whisper-large-v3-turbo (STT), llama-3.3-70b-versatile (LLM)
GROQ_API_KEY=your_groq_api_key_here

# System dependencies (install separately — NOT npm packages):
#   yt-dlp  — installed automatically by the yt-dlp-exec npm package.
#   ffmpeg  — must be installed manually:
#               Windows: winget install ffmpeg
#               macOS:   brew install ffmpeg
#               Linux:   sudo apt install ffmpeg

# Person 2 — Signal Validation Agent
# Finnhub — earnings calendar + company news (60 calls/min free tier)
# Get a free key at https://finnhub.io/register
FINNHUB_KEY=your_finnhub_key_here

# Person 3 — Predictor Credibility Agent
# Twitter/X API v2 — predictor post history (500k reads/month free)
# Apply at https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# YouTube Data API v3 — channel stats + video history (10k units/day free)
# Get a key at https://console.cloud.google.com/ (enable YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key_here
