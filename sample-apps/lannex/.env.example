# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Database Configuration - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Server Ports
PORT=3000
WEBHOOK_PORT=3001

# Application Defaults
MONTHLY_BUDGET=5000
DEFAULT_HOURLY_WAGE=500
DEFAULT_RETURN_RATE=12
TAX_SAVER_ROOM=1500
DEFAULT_UPI_ID=user@upi

# Optional: Vision API Keys (for headless OCR)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
