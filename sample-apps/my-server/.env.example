# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# GitHub API Authentication
# No GitHub credential is required to start the server.
# Required only when using browser redirect login.
# GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
# Required for browser redirect login unless NITROSTACK_PUBLIC_URL is provided.
# RESOURCE_URI=https://your-app.nitrocloud.app
# Optional explicit callback override. Must match the GitHub OAuth App callback URL.
# GITHUB_OAUTH_REDIRECT_URI=https://your-app.nitrocloud.app/auth/github/callback
# Optional non-interactive fallback.
# GITHUB_TOKEN=your_github_personal_access_token

# NitroStack OAuth 2.1 Server Metadata
# Optional unless you want to override the defaults in src/app.module.ts.
# RESOURCE_URI should be the public NitroCloud URL for this MCP server.
# AUTH_SERVER_URL=https://github.com
# OAUTH_REQUIRED=false
# Set these when OAUTH_REQUIRED=true.
# JWKS_URI=
# TOKEN_AUDIENCE=
# TOKEN_ISSUER=
# INTROSPECTION_ENDPOINT=
# INTROSPECTION_CLIENT_ID=
# INTROSPECTION_CLIENT_SECRET=

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=0.0.0.0
# MCP_BASE_PATH=/mcp
# ENABLE_CORS=true
