{
  "name": "GVR",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Finance & Tax Copilot — a NitroStack MCP server orchestrating real Indian tax, mutual-fund, bank and compliance data",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "test": "npm run build && node --test --test-force-exit",
    "widget": "npm --prefix src/widgets"
  },
  "keywords": [
    "nitrostack",
    "mcp",
    "finance",
    "tax",
    "mutual-funds",
    "india"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "@modelcontextprotocol/ext-apps": ">=0.1.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
