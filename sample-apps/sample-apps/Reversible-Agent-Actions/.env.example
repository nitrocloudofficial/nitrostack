# Environment Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
API_KEY=Your API key here (replace with a secure value for production)
DB_PATH=/tmp/journal.db
# --- Production / NitroCloud deploy checklist ---
# NODE_ENV=production   # anything other than 'development'/'dev' switches
#                       # NitroStackServer to dual HTTP+stdio transport
#                       # (see src/index.ts) — set by nitrostack-cli start.
# PORT=3000             # HTTP transport port.
# HOST=0.0.0.0          # @nitrostack/core defaults to 'localhost', which is
#                       # unreachable from outside a container — required for
#                       # NitroStudio / remote MCP clients to reach the
#                       # deployed server.
# API_KEY=              # Gates the deployed HTTP transport (/mcp), not individual
#                       # tool calls: set via ApiKeyGateService (src/txn/services/
#                       # api-key-gate.service.ts), which mounts Express middleware
#                       # requiring an `X-API-Key` header matching this value on
#                       # every HTTP request to /mcp. This only protects the public
#                       # NitroCloud HTTP endpoint; it does not apply to stdio
#                       # connections (NitroStudio, Claude Desktop, etc.), which
#                       # never go through HTTP at all. Leave unset to run without
#                       # this gate (e.g. local dev).
# DB_PATH=/data/journal.db  # NitroCloud persistent volume — without this, the
#                       # SQLite journal lives in the container's ephemeral
#                       # filesystem and is lost on scale-to-zero.
