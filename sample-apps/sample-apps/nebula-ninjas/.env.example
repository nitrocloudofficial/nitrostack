# Sentinel Gateway Configuration
# ═══════════════════════════════════════════════

# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
# MCP_TRANSPORT_TYPE: stdio | http | dual
MCP_TRANSPORT_TYPE=http
PORT=3000
HOST=localhost
ENABLE_CORS=true

# Sentinel Gateway Configuration
# ═══════════════════════════════════════════════

# Admin secret for gateway self-protection
# Used to authenticate policy changes and admin actions
SENTINEL_ADMIN_SECRET=sentinel-dev-secret-change-in-prod

# Anthropic API Key (optional — enables LLM-based injection classification)
# Without this, the injection detector uses heuristic patterns only
# ANTHROPIC_API_KEY=sk-ant-...

# Mock Server URLs (default ports for local development)
MOCK_FILESYSTEM_URL=http://localhost:3001
MOCK_CRM_URL=http://localhost:3002
MOCK_EMAIL_URL=http://localhost:3003
