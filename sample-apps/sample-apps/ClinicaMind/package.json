{
  "name": "clinica-mind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ClinicaMind: AI clinical decision support workspace built with NitroStack MCP.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "migrate": "npx tsx src/db/migrate.ts",
    "seed": "npx tsx src/db/seed.ts"
  },
  "keywords": [
    "clinica",
    "clinical",
    "nitrostack",
    "mcp",
    "react-flow",
    "healthcare"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "@prisma/client": "^7.9.0",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^16.3.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.9.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
