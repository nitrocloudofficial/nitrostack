# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# =============================================================================
# Secure Data Gateway Configuration
# =============================================================================
# JWT_SECRET: HMAC signing secret for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN_SECONDS=3600

# MASTER_KEY_PASSPHRASE: root secret the KeyManagementService uses (via
# Argon2id) to derive the active AES-256-GCM master key. Treat like a
# database root password — never commit a real value.
MASTER_KEY_PASSPHRASE=change-me-to-a-long-random-passphrase
MASTER_KEY_VERSION=v1

# Comma-separated list of "internal-service-name:api-key" pairs used for
# service-to-service API key authentication (e.g. AI Gateway callbacks).
# Example: ai-gateway:ak_live_xxxxx,file-service:ak_live_yyyyy
INTERNAL_API_KEYS=

# Rate limiting (requests per window per user/key)
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_AUTH_ATTEMPTS_PER_15MIN=10

# Where encrypted-at-rest records and files are persisted (gateway-only access)
SECURE_STORE_DIR=./secure-store
