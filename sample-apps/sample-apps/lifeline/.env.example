# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# Lifeline Routing Configuration
# =============================================================================
# ORS_API_KEY: OpenRouteService API key used by calculate_route for live
# ETA/distance/route-geometry lookups. Get a free key at
# https://openrouteservice.org/dev/#/signup (2000 requests/day on the free tier).
# If unset, calculate_route automatically falls back to a haversine-distance
# estimate — routing never blocks emergency dispatch.
# =============================================================================
# ORS_API_KEY=

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
