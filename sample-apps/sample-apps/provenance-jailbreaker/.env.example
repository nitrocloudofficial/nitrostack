# ==========================================================
# PROVENANCE-GUARDED RED-TEAM HARNESS — MERGED PROJECT
# Environment Configuration
# ==========================================================

# ── Person A: Ollama Target Models ────────────────────────
# Ollama must be running locally. Pull models before starting:
#   ollama pull phi3:mini
#   ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
TARGET_MODEL_V1=phi3:mini
TARGET_MODEL_V2=qwen2.5:3b
TARGET_MODEL_TEMPERATURE=0.7

# ── Person B: Scope Guard LLM (choose one) ────────────────
# Option 1: OpenAI (recommended for scope guard)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Option 2: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Person C: LLM Judge (choose one) ─────────────────────
# Option 1: OpenAI GPT-4o-mini (default judge)
# Uses OPENAI_API_KEY from above — no extra config needed.
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_MODEL=gpt-4o-mini
JUDGE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Option 2: Anthropic judge
# JUDGE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# JUDGE_LLM_MODEL=claude-3-5-haiku-20241022

# Option 3: Use Ollama as judge (no API key required)
# JUDGE_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# JUDGE_LLM_MODEL=qwen2.5:3b

# ── Mock Mode (offline demo, no API calls) ─────────────────
# Set to true to run fully offline with deterministic mock judges
USE_MOCK_JUDGES=false

# ── Person B: MongoDB (Audit Chain) ───────────────────────
MONGODB_URI=mongodb://localhost:27017/redteam-audit

# ── Person B: Session Log Path ────────────────────────────
SESSION_LOG_PATH=./data/sessions.jsonl

# ── NitroStack Configuration ──────────────────────────────
NITRO_LOG_LEVEL=info

# -- Provenance Guard Configuration ------------------------
AUDIT_HMAC_KEY=1234567890abcdef1234567890abcdef
AUDIT_LOG_PATH=./data/audit.jsonl
USE_MOCK_NLI=true
VIRUSTOTAL_API_KEY=
