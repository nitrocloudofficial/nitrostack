# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
PORT=3001
HOST=localhost
# ENABLE_CORS=true
# FACTORYBRAIN_GATEWAY_URL=http://localhost:3001
# FACTORYBRAIN_RESOURCE_URI=http://localhost:3001/mcp
# FACTORYBRAIN_AUTH_SERVER=https://your-identity-provider.example
# OAUTH_REQUIRED=false
# JWKS_URI=https://your-identity-provider.example/.well-known/jwks.json

# FactoryBrain durable infrastructure (recommended outside local unit tests)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=factorybrain
# REDIS_URL=redis://localhost:6379
# FACTORYBRAIN_QUEUE_PREFIX=factorybrain
# FACTORYBRAIN_QUEUE_ATTEMPTS=5
# FACTORYBRAIN_QUEUE_CONCURRENCY=10

# Real-service integration tests (use with docker-compose.integration.yml)
# TEST_MONGODB_URI=mongodb://localhost:27017
# TEST_REDIS_URL=redis://localhost:6379

# Manager Agent policy
# FACTORYBRAIN_DOWNTIME_COST_PER_HOUR=2500
# FACTORYBRAIN_APPROVAL_THRESHOLD=1000
# FACTORYBRAIN_DELAY_COST_FACTOR=0.35
# FACTORYBRAIN_AUTO_APPROVAL=true

# Notification Agent recipients and live dashboard
# FACTORYBRAIN_NOTIFICATION_ATTEMPTS=3
# FACTORYBRAIN_MAINTENANCE_EMAIL=maintenance@factorybrain.local
# FACTORYBRAIN_PROCUREMENT_EMAIL=procurement@factorybrain.local
# FACTORYBRAIN_REQUESTER_EMAIL=requester@factorybrain.local
# FACTORYBRAIN_FLOOR_SUPERVISOR_NAME=Floor Supervisor
# FACTORYBRAIN_FLOOR_SUPERVISOR_EMAIL=floor-supervisor@factorybrain.local
# FACTORYBRAIN_WEBSOCKET_ENABLED=true
# FACTORYBRAIN_WEBSOCKET_HOST=127.0.0.1
# The WebSocket service is separate from the MCP HTTP listener, so use a different port.
# FACTORYBRAIN_WEBSOCKET_PORT=3002
# NEXT_PUBLIC_FACTORYBRAIN_GATEWAY_URL=http://localhost:3001
# Socket.IO accepts this HTTP origin and upgrades the connection to WebSocket.
# NEXT_PUBLIC_FACTORYBRAIN_WEBSOCKET_URL=http://localhost:3002

# Monitoring Agent polling and stage deadline overrides
# FACTORYBRAIN_MONITOR_POLL_INTERVAL_MS=5000
# FACTORYBRAIN_STAGE_SUPPLIER_ACCEPTED_MINUTES=240
# FACTORYBRAIN_STAGE_PART_SHIPPED_MINUTES=1440
# FACTORYBRAIN_STAGE_REPAIR_STARTED_MINUTES=240

# Provider-neutral OpenAI-compatible AI endpoint
# FACTORYBRAIN_AI_BASE_URL=https://your-provider.example/v1
# FACTORYBRAIN_AI_API_KEY=
# FACTORYBRAIN_AI_MODEL=gpt-5-mini
# FACTORYBRAIN_AI_TIMEOUT_MS=30000
# FACTORYBRAIN_AI_RETRIES=2
# Per-task override example: FACTORYBRAIN_AI_MODEL_FAILURE_ANALYSIS=gpt-5-mini
