# Converra One Environment Variables Template

# Integration Modes
USE_REAL_INTEGRATIONS=false
ENABLE_DEMO_MODE=true

# Server Configuration
PORT=3001
NODE_ENV=development
GMAIL_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/auth/google/callback


# Gmail OAuth Credentials
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_USER_EMAIL=alex.mercer@converra.io

# Google Calendar API Credentials
GOOGLE_CALENDAR_ID=primary

# GitHub Enterprise Integration Token
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Slack Web API Bot Token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Discord Bot Token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Notion Integration API Token
NOTION_API_TOKEN=secret_your_notion_api_token
