# Dependencies
node_modules/
src/widgets/node_modules/

# Build outputs
dist/
.next/
out/
src/widgets/.next/
src/widgets/out/

# Framework documentation, duplicated by the scaffold.
#
# `nitrostack init` writes the same five SKILL.md files into eight directories,
# one per AI coding tool. They are byte-identical, so we keep .claude/skills and
# ignore the rest rather than carrying 40 copies of the same docs.
.agents/
.antigravity/
.codex/
.copilot/
.cursor/
.gemini/
.opencode/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Uploads
uploads/

# TypeScript cache
*.tsbuildinfo

# Regenerated by Next.js on every widget build
src/widgets/next-env.d.ts

# Optional npm cache
.npm/

# Optional eslint cache
.eslintcache

# OAuth tokens/secrets (never commit these!)
*.pem
*.key
tokens.json

# Added by nitrostack pack
.git/

# The deploy archive produced by `nitrostack pack`. It is a build artifact
# rebuilt from source on demand, so committing it would only add ~190KB of
# binary to every clone and go stale the moment src/ changes.
*.zip
