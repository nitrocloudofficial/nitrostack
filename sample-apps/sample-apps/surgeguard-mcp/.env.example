# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# The included runtime is a synthetic, no-side-effect adapter.
SURGEGUARD_DEMO_MODE=true

# Optional local database override. The default is data/surgeguard-demo.sqlite.
# SURGEGUARD_DATABASE_PATH=./data/surgeguard-demo.sqlite

# Production adapters (documented placeholders; never commit real values)
# DATABASE_URL=postgresql://user:password@host:5432/surgeguard
# OAUTH_ISSUER=https://identity.example.org
# OAUTH_AUDIENCE=surgeguard-mcp

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
