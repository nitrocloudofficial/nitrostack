# Copy to .env and fill in real values. Never commit .env.

# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# GroundTruth — GitHub integration
# =============================================================================
# GitHub Personal Access Token (classic) with 'repo' read scope.
# Used by crosscheck_activity to pull the real commit/PR data that GroundTruth
# verifies EOD claims against. Create one at github.com/settings/tokens.
GITHUB_TOKEN=

# GitHub org or username that owns the repos to inspect.
GITHUB_ORG=

# Optional: restrict the check to specific repos, comma-separated.
# Accepts "owner/repo" or a bare repo name (resolved under GITHUB_ORG).
# Leave blank to scan the 30 most recently pushed repos under GITHUB_ORG.
# Setting this explicitly makes cross-checks faster and more predictable.
GITHUB_REPOS=

# Optional: override the GitHub API base. Only needed for GitHub Enterprise,
# or by the integration test, which points it at a local mock.
# GITHUB_API_URL=https://api.github.com

# Optional: post manager alerts to a Slack channel as well as recording them.
# Leave blank and nothing is ever sent. Create an Incoming Webhook at
# api.slack.com/messaging/webhooks. Delivery failures never fail the alert.
SLACK_WEBHOOK_URL=

# Used by `npm run demo:prepare` to point emp-1 at a real GitHub identity.
# DEMO_GITHUB_EMAIL should match `git config user.email` on the machine committing.
DEMO_GITHUB_LOGIN=
DEMO_GITHUB_EMAIL=

# Re-seed demo history on boot when the store is empty. Useful on a deployed
# instance, where every redeploy starts with an empty data file. Never overwrites
# existing reports.
DEMO_AUTOSEED=
DEMO_AUTOSEED_DAYS=3
