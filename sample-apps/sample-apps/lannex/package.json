{
  "name": "lannex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An assistant that manages your daily spending, splits bills, reminds friends to pay you back, and automatically tracks your investments for opportunities",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "npx prisma generate && nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "@prisma/client": "^6.19.3",
    "body-parser": "^2.3.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "author": "",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
