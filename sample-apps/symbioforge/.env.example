# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# OAuth Configuration (Optional)
# =============================================================================
# OAuth discovery is configured so OpenAI/Cursor-style clients can discover
# protected-resource metadata. Auth is not enforced unless OAUTH_REQUIRED=true.
# =============================================================================
# OAUTH_REQUIRED=false
# RESOURCE_URI=http://localhost:3000/mcp
# AUTH_SERVER_URL=http://localhost:3000
# JWKS_URI=
# INTROSPECTION_ENDPOINT=
# INTROSPECTION_CLIENT_ID=
# INTROSPECTION_CLIENT_SECRET=
# TOKEN_AUDIENCE=
# TOKEN_ISSUER=

# Web Application Auth (Optional)
# =============================================================================
# When these are set, the Next.js dashboard can use Supabase email/password auth.
# Set AUTH_REQUIRED=true in production to enforce login across the dashboard.
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# AUTH_REQUIRED=false
# GROQ_API_KEY=
