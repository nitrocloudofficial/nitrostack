# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# External APIs used by this server are FREE and need NO API keys:
#   - Mutual fund NAV/history : https://api.mfapi.in        (public, keyless)
#   - Bank IFSC verification  : https://ifsc.razorpay.com   (public, keyless)
# Optional: override the base URLs (e.g. for a local proxy/mirror).
# MFAPI_BASE_URL=https://api.mfapi.in
# IFSC_BASE_URL=https://ifsc.razorpay.com

# Outbound HTTP timeout in milliseconds for the above APIs.
# HTTP_TIMEOUT_MS=10000
