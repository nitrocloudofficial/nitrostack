# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# CoinGecko
# Optional. The public tier works without a key; set this to use a demo key
# and get higher rate limits. Leave unset rather than committing a real key.
COINGECKO_API_KEY=your_key

# =============================================================================
# Transport / hosting
# =============================================================================
# Resolved by @nitrostack/core at startup:
#   MCP_TRANSPORT_TYPE takes precedence when set (stdio | http | dual)
#   NODE_ENV unset/development/dev -> stdio
#   NODE_ENV=production            -> dual (STDIO + HTTP)
#
# Local dev (Studio talks over STDIO) needs none of these.
#
# For a hosted deployment you generally want an HTTP listener:
#   NODE_ENV=production
#   MCP_TRANSPORT_TYPE=http
#   PORT=3000
#   HOST=0.0.0.0
#
# HOST matters: the framework default is `localhost`, which inside a container
# only accepts loopback traffic and will fail an external health probe.
# Bind 0.0.0.0 so the platform can reach the server.
#
# The MCP endpoint is served at /mcp and health at /mcp/health.
# =============================================================================
# NODE_ENV=production
# MCP_TRANSPORT_TYPE=http
# PORT=3000
# HOST=0.0.0.0
# ENABLE_CORS=true
