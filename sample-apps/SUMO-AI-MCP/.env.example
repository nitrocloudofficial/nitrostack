# =============================================================================
# NitroStack & Application Environment Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode (stdio | http | dual).
# Defaults to 'stdio' in local dev and 'dual' in cloud/production.
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# SUMO Traffic Simulator Configuration
# =============================================================================
# SUMO_HOME: Path to your local SUMO installation root directory
# Windows example: C:\Program Files (x86)\Eclipse\Sumo
# Linux / Docker example: /usr/share/sumo
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# SUMO_WORKSPACE_DIR: Directory where simulation output files are stored
SUMO_WORKSPACE_DIR=.

# Python Executable Configuration
# =============================================================================
# PYTHON_PATH: Binary name or absolute path to Python executable
# Windows example: python or E:\application file\Python\python.exe
# Linux / Cloud example: python3 or python
PYTHON_PATH=python

# Execution Mode Settings
# =============================================================================
# HEADLESS_MODE: Set 'true' for headless cloud containers, 'false' for local GUI playback
HEADLESS_MODE=false
NITRO_CLOUD=false
