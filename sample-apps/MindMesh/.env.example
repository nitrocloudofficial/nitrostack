# Core
NODE_ENV=development
LOG_LEVEL=info

# Semantic Scholar (free tier: 100 req/5min, API key recommended for higher limits)
SEMANTIC_SCHOLAR_API_KEY=

# GitHub (for code search)
GITHUB_TOKEN=

# Embeddings Provider: "local" (Xenova/transformers) or "openai"
EMBEDDING_PROVIDER=local

# OpenAI (only needed if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Overleaf Git Integration (for Mode 2)
OVERLEAF_GIT_URL=
OVERLEAF_GIT_TOKEN=

# Memory Persistence
MEMORY_PERSIST_PATH=./data/memory.json
MEMORY_PERSIST_INTERVAL_MS=30000

# Scimago Journal Quartile Lookup (optional)
# Download CSV from https://www.scimagojr.com/journalrank.php
SCIMAGO_QUARTILE_CSV=./data/scimago-quartiles.csv

# OAuth (optional - for authenticated MCP transport)
# OAUTH_REQUIRED=false
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# JWKS_URI=
# TOKEN_INTROSPECTION_ENDPOINT=