# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=OLLAMA

# DawnMCP Local AI Strategy
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
DATA_DIR=./data
LOG_LEVEL=info

# Server Transport Configuration
# dual = STDIO (for Cursor/Claude Desktop) + HTTP/SSE (for NitroStudio & Widget Dev Server port 3001)
MCP_TRANSPORT_TYPE=dual
PORT=3000
HOST=localhost
ENABLE_CORS=true
