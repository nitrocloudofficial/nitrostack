{
  "name": "geotrust-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GeoTrust AI — Business authenticity investigation MCP server for SME loan onboarding",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "build:all": "npm run build && npm run widget:build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install && npm --prefix src/widgets ci",
    "widget": "npm --prefix src/widgets",
    "widget:dev": "npm --prefix src/widgets run dev",
    "widget:build": "npm --prefix src/widgets run build",
    "deploy": "npm run build:all && npm run validate && echo Ready for git push deploy",
    "validate": "node -e \"const fs=require('fs'); ['dist/index.js','src/widgets/widget-manifest.json'].forEach(f=>{if(!fs.existsSync(f)){console.error('Missing: '+f);process.exit(1)}; console.log('OK: '+f)})\"",
    "chef": "npx tsx chef/investigate.ts",
    "chef:genuine": "npx tsx chef/investigate.ts --fixture genuine",
    "chef:suspicious": "npx tsx chef/investigate.ts --fixture suspicious",
    "chef:ambiguous": "npx tsx chef/investigate.ts --fixture ambiguous",
    "chef:all": "npx tsx chef/investigate.ts --fixture all"
  },
  "keywords": [
    "nitrostack",
    "mcp",
    "geotrust",
    "fraud-detection",
    "loan-verification",
    "business-authenticity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "openai": "^4.104.0",
    "string-similarity": "^4.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "@types/string-similarity": "^4.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
