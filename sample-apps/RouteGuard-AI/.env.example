# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# Mapbox Configuration (Optional)
# =============================================================================
# The map widget uses Mapbox GL for interactive maps.
# Get a free API key at: https://www.mapbox.com/
# =============================================================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# NewsAPI Configuration
# =============================================================================
# Used by SentinelService to scan live news for supply chain disruptions.
# Get a free API key at: https://newsapi.org/
# Free tier: 100 requests/day, developer use only (not for production).
# Leave as 'demo' to use mock fallback data.
# =============================================================================
NEWSAPI_KEY=demo

# OpenWeatherMap Configuration
# =============================================================================
# Used by SentinelService to check weather alerts at major ports.
# Get a free API key at: https://openweathermap.org/api
# Free tier: 1,000 calls/day (One Call API 3.0 requires subscription).
# Leave as 'demo' to use mock fallback data.
# =============================================================================
OPENWEATHER_KEY=demo

# Database Configuration (Optional)
# =============================================================================
# Used by DatabaseService for persistent storage.
# Currently runs as an in-memory mock when not set.
# For production, set to a valid PostgreSQL connection string.
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain

# Redis Cache Configuration (Optional)
# =============================================================================
# Used by CacheService to cache threat feeds, carrier rates, and impact results.
# Currently runs as an in-memory mock when not set.
# For production, set to a valid Redis connection string.
# =============================================================================
# REDIS_URL=redis://localhost:6379

# Supply Chain Configuration (Optional)
# =============================================================================
# THREAT_CACHE_TTL_SECONDS: How long to cache the threat feed (default: 3600 = 1 hour)
# CARRIER_RATE_CACHE_TTL_SECONDS: How long to cache carrier rates (default: 7200 = 2 hours)
# IMPACT_CACHE_TTL_SECONDS: How long to cache impact analyses (default: 1800 = 30 min)
# HIGH_VALUE_SHIPMENT_THRESHOLD: USD value above which a shipment is flagged high-value (default: 50000)
# =============================================================================
# THREAT_CACHE_TTL_SECONDS=3600
# CARRIER_RATE_CACHE_TTL_SECONDS=7200
# IMPACT_CACHE_TTL_SECONDS=1800
# HIGH_VALUE_SHIPMENT_THRESHOLD=50000
