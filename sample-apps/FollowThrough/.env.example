# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# Follow-Through Configuration
# =============================================================================
# SCHEDULER_INTERVAL_MS: how often the poll/decide loop runs in production.
# The demo uses simulate_days_passing instead of waiting on this timer.
# SCHEDULER_INTERVAL_MS=3600000

# DATA_DIR: where the JSON store lives (defaults to <cwd>/data).
# On serverless hosts (NitroCloud) the container filesystem is read-only, so
# the store auto-falls back to the OS temp dir, then to in-memory only.
# Set DATA_DIR if your platform provides a writable persistent volume.
# DATA_DIR=/data

# Optional: enable live LLM extraction. When no provider is configured,
# extraction falls back to the deterministic offline extractor so the
# demo works without any network or API key.
#
# LLM_PROVIDER: auto | anthropic | openrouter | none (default: auto)
#   auto       - uses Anthropic if ANTHROPIC_API_KEY is set, else OpenRouter
#                if OPENROUTER_API_KEY is set, else the offline extractor
#   anthropic  - requires ANTHROPIC_API_KEY (paid)
#   openrouter - requires OPENROUTER_API_KEY (free tier models available,
#                e.g. meta-llama/llama-3.1-8b-instruct:free)
#   none       - always use the offline extractor
# LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Real provider integration (all optional).
# When none of these are configured the server runs in demo mode and uses
# built-in fixtures for Slack/email/Linear so the walkthrough works offline.
# =============================================================================

# Slack: evidence search + DM nudges. Scopes: channels:history, groups:history,
# im:history, users:read, chat:write, users:read.email
#SLACK_BOT_TOKEN=
#SLACK_EVIDENCE_CHANNELS=general,standup

# Email: SMTP for outbound nudges, IMAP for evidence search.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=follow-through@example.com
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASS=
# EMAIL_IMAP_MAILBOX=INBOX

# Linear: create/read/update/escalate tickets.
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

