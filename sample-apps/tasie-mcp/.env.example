# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# TASIE backend (the FastAPI security engine this MCP app proxies)
# =============================================================================
# TASIE_API_BASE: base URL of a running TASIE backend. Local dev default is
#   http://localhost:8000. For cloud deployment, point this at a publicly
#   reachable TASIE host (the stateless scan tools work anywhere; the
#   exploit/remediate tools need the full Docker-enabled host).
# TASIE_API_KEY: optional bearer token, sent as `Authorization: Bearer <key>`.
# TASIE_TIMEOUT_MS: per-request timeout (default 120000).
# =============================================================================
TASIE_API_BASE=http://localhost:8000
# TASIE_API_KEY=
# TASIE_TIMEOUT_MS=120000

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
