    "lucide-react": "^1.28.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "Visionnatrix",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
