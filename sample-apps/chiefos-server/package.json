{
  "name": "chiefos-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChiefOS AI Chief of Staff - An MCP-based multi-agent system that intelligently triages emails, meetings, calendars, and tasks while requiring human approval and maintaining a complete audit trail.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
