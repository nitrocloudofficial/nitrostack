{
  "schemaVersion": "1.0",
  "id": "fasta-validation-rules",
  "version": "v1",
  "sourceKind": "CONFIGURATION",
  "scientificUse": false,
  "strictAlphabet": [
    "A",
    "C",
    "D",
    "E",
    "F",
    "G",
    "H",
    "I",
    "K",
    "L",
    "M",
    "N",
    "P",
    "Q",
    "R",
    "S",
    "T",
    "V",
    "W",
    "Y"
  ],
  "ambiguousResidues": ["B", "J", "X", "Z"],
  "nonStandardResidues": ["O", "U"],
  "requireSingleRecord": true,
  "requireHeader": true,
  "allowWhitespace": true,
  "stripSingleTerminalStop": true,
  "maxBytes": 1048576,
  "maxResidues": 10000
}
