{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immunograph:schema:fixture-case:v1",
  "title": "ImmunoGraph exact-match synthetic fixture case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "reviewStatus",
    "sourceKind",
    "scientificUse",
    "disclaimer",
    "proteinSha256",
    "metadata",
    "selectors"
  ],
  "properties": {
    "schemaVersion": { "const": "fixture-case.v1" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "reviewStatus": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
    "sourceKind": { "const": "SYNTHETIC" },
    "scientificUse": { "const": false },
    "disclaimer": {
      "const": "Computational demonstration only. Synthetic sequences, scores, rankings, and coverage are not experimental, clinical, efficacy, or pathogen-reference results."
    },
    "proteinSha256": { "$ref": "#/$defs/sha256" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioName", "organismLabel", "proteinName", "description", "sequenceNature"],
      "properties": {
        "scenarioName": { "type": "string", "minLength": 1 },
        "organismLabel": { "const": "Synthetic demonstration" },
        "proteinName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sequenceNature": { "const": "SYNTHETIC_NOT_PATHOGEN_REFERENCE" }
      }
    },
    "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proteinSha256",
        "track",
        "methods",
        "alleles",
        "peptideLengths",
        "parametersHash",
        "outputSchemaVersion",
        "runProfile"
      ],
      "properties": {
        "proteinSha256": { "$ref": "#/$defs/sha256" },
        "track": { "enum": ["MHCI", "MHCII", "BCELL"] },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/method" }
        },
        "alleles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "peptideLengths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "parametersHash": { "$ref": "#/$defs/sha256" },
        "outputSchemaVersion": { "type": "string", "minLength": 1 },
        "runProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ruleProfileVersion", "rankingProfileVersion"],
          "properties": {
            "ruleProfileVersion": { "type": "string", "minLength": 1 },
            "rankingProfileVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
