{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immunograph:schema:prediction-observation:v1",
  "title": "ImmunoGraph synthetic prediction fixture payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceKind",
    "scientificUse",
    "disclaimer",
    "observations",
    "bcell",
    "coverage",
    "optimization"
  ],
  "properties": {
    "schemaVersion": { "const": "prediction-observation.v1" },
    "sourceKind": { "const": "SYNTHETIC" },
    "scientificUse": { "const": false },
    "disclaimer": { "$ref": "#/$defs/disclaimer" },
    "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
    "bcell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "methodVersion",
        "sourceStatus",
        "residueScores",
        "regions",
        "rawMethodFields",
        "provenance"
      ],
      "properties": {
        "method": { "const": "GraphBepi" },
        "methodVersion": { "const": "synthetic-fixture-v1" },
        "sourceStatus": { "const": "FIXTURE" },
        "residueScores": { "type": "array", "items": { "$ref": "#/$defs/residueScore" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "rawMethodFields": { "type": "object" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectedCoverage", "populationIds", "classMode", "metrics", "provenance"],
      "properties": {
        "projectedCoverage": { "$ref": "#/$defs/unit" },
        "populationIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "classMode": { "enum": ["CLASS_I", "CLASS_II", "COMBINED"] },
        "metrics": { "type": "object" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "selectedCandidateIds", "finalCoverage", "provenance"],
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "selectedCandidateIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "finalCoverage": { "$ref": "#/$defs/unit" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "disclaimer": {
      "const": "Computational demonstration only. Synthetic sequences, scores, rankings, and coverage are not experimental, clinical, efficacy, or pathogen-reference results."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "scientificUse",
        "sourceStatus",
        "fixtureId",
        "sourceUri",
        "disclaimer"
      ],
      "properties": {
        "sourceKind": { "const": "SYNTHETIC" },
        "scientificUse": { "const": false },
        "sourceStatus": { "const": "FIXTURE" },
        "fixtureId": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": "string", "pattern": "^urn:immunograph:synthetic-fixture:" },
        "disclaimer": { "$ref": "#/$defs/disclaimer" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "candidateRef",
        "candidateType",
        "peptide",
        "start",
        "end",
        "length",
        "method",
        "methodVersion",
        "rawScore",
        "percentileRank",
        "allele",
        "rawFields",
        "sourceStatus",
        "provenance"
      ],
      "properties": {
        "observationId": { "type": "string", "minLength": 1 },
        "candidateRef": { "type": "string", "minLength": 1 },
        "candidateType": { "enum": ["MHCI", "MHCII"] },
        "peptide": { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$" },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "length": { "type": "integer", "minimum": 1 },
        "method": { "type": "string", "minLength": 1 },
        "methodVersion": { "type": "string", "minLength": 1 },
        "rawScore": { "type": "number" },
        "percentileRank": { "type": "number", "minimum": 0 },
        "allele": { "type": "string", "minLength": 1 },
        "rawFields": { "type": "object" },
        "sourceStatus": { "const": "FIXTURE" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "residueScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "score"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "score": { "$ref": "#/$defs/unit" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "score"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "score": { "$ref": "#/$defs/unit" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "marginalGain", "cumulativeCoverage"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "marginalGain": { "$ref": "#/$defs/unit" },
        "cumulativeCoverage": { "$ref": "#/$defs/unit" }
      }
    }
  }
}
