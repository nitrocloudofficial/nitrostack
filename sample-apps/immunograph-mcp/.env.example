# NitroStack Configuration
NODE_ENV=production
HOST=0.0.0.0
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai
MCP_TRANSPORT_TYPE=http

# OAuth 2.1 discovery configuration
# Set RESOURCE_URI to the public NitroCloud URL for this MCP server.
# Keep OAUTH_REQUIRED=false unless NitroCloud/auth provider credentials are configured.
RESOURCE_URI=http://localhost:3000
AUTH_SERVER_URL=https://auth.example.com
OAUTH_REQUIRED=false
# TOKEN_AUDIENCE=
# TOKEN_ISSUER=
# JWKS_URI=
# INTROSPECTION_ENDPOINT=
# INTROSPECTION_CLIENT_ID=
# INTROSPECTION_CLIENT_SECRET=

# LLM orchestration
AGENT_MODE=DETERMINISTIC
LLM_ENABLED=false
# OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000

# Live scientific connectors
IEDB_LIVE_ENABLED=true
IEDB_TIMEOUT_MS=120000
IEDB_MAX_RESPONSE_BYTES=10485760
IEDB_POPULATION_COVERAGE_ENABLED=true
# IEDB_POPULATION_COVERAGE_SCRIPT_PATH=/opt/iedb/population_coverage/calculate_population_coverage.py
IEDB_POPULATION_COVERAGE_PYTHON_COMMAND=python3
IEDB_POPULATION_COVERAGE_TIMEOUT_MS=120000
IEDB_POPULATION_COVERAGE_MAX_RESPONSE_BYTES=10485760

MHCFLURRY_ENABLED=false

STRUCTURE_ENABLED=true
RCSB_PDB_ENABLED=true
ALPHAFOLD_DB_ENABLED=true

CHEMISTRY_ENABLED=true
PUBCHEM_ENABLED=true
RDKIT_ENABLED=false
RDKIT_PYTHON_COMMAND=python3
OPENBABEL_ENABLED=false
OPENBABEL_COMMAND=obabel

DOCKING_ENABLED=true
VINA_ENABLED=false
VINA_COMMAND=vina
PLIP_ENABLED=false
PLIP_COMMAND=plipcmd
FPOCKET_ENABLED=false
FPOCKET_COMMAND=fpocket
FREESASA_ENABLED=false
FREESASA_COMMAND=freesasa
MOLSTAR_ENABLED=true

# Optional server transport values. NitroCloud usually provides PORT.
# PORT=3000
# ENABLE_CORS=true
