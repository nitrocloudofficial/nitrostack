{
  "name": "RakshaNet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RakshaNet - Autonomous AI-powered women's safety system that monitors contextual risk and proactively verifies user safety using NitroStack MCP tools.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "keywords": [
    "nitrostack",
    "mcp",
    "map",
    "widgets"
  ],
