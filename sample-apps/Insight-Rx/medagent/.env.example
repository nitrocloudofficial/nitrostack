# =============================================================================
# Autonomous Medical Imaging Diagnosis & Clinical Decision Agent
# .env.example — copy to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# HOW THIS FILE IS CONSUMED
#   src/medagent/utils/settings.py loads this file from the REPO ROOT
#   (not the process working directory, so it applies no matter where you
#   start the app from), in two ways:
#
#     1. pydantic-settings populates Settings for every key below marked
#        [app]  — these are read by this project's own code.
#     2. load_dotenv() copies everything into os.environ, so keys marked
#        [sdk] reach their vendor library directly (mlflow, huggingface_hub,
#        anthropic, openai, streamlit).
#
#   Anything already exported in your real environment wins over this file,
#   which is what CI and container deployments expect.
#
# VERIFY YOUR CONFIGURATION ACTUALLY APPLIED:
#   python3 -m medagent.utils.settings
#   (prints the resolved values, with every secret masked)
# =============================================================================

# --- App / Runtime ---
APP_ENV=development                  # [app] development | staging | production
LOG_LEVEL=INFO                       # [app] DEBUG | INFO | WARNING | ERROR
DEVICE=auto                          # [app] auto (cuda>mps>cpu) | cpu | mps (Apple Silicon) | cuda
RANDOM_SEED=42                       # [app]
# [app] Enforced as a real network guard, not a comment: the Semantic Scholar
# client refuses to make outbound calls while this is true. Keeping it true is
# what keeps patient data inside the institution (REG-002 §1.2).
OFFLINE_MODE=true

# --- LLM Providers ---
# Local-first: Ollama is the default runtime so the whole pipeline runs offline.
LLM_BACKEND=ollama                   # [app] NOTE: the field is LLM_BACKEND, not LLM_PROVIDER
OLLAMA_BASE_URL=http://localhost:11434   # [app] every agent's LLM call is routed here
OLLAMA_MODEL=llama3.1:8b             # [app] generic fallback; per-agent models below win
LLM_MAX_NEW_TOKENS=512               # [app]

# Per-agent model routing (llm/loader.py). These must be tags you have
# actually `ollama pull`-ed. verifier deliberately differs from report to
# avoid a model grading its own output.
DIAGNOSIS_LLM_MODEL=qwen2.5:14b-instruct     # [app]
DIAGNOSIS_LLM_TEMPERATURE=0.2                # [app]
EVIDENCE_LLM_MODEL=qwen2.5:7b-instruct       # [app]
EVIDENCE_LLM_TEMPERATURE=0.0                 # [app]
REPORT_LLM_MODEL=llama3.1:8b-instruct        # [app]
REPORT_LLM_TEMPERATURE=0.3                   # [app]
VERIFIER_LLM_MODEL=qwen2.5:7b-instruct       # [app]
VERIFIER_LLM_TEMPERATURE=0.0                 # [app]

# Cloud provider credentials — optional. Consumed by the vendor SDK from
# os.environ, which load_dotenv() populates from this file.
# [sdk] only for gated checkpoints (e.g. Llama-3 weights)
HUGGINGFACE_HUB_TOKEN=
HF_HOME=./models/checkpoints/.hf_cache   # [sdk]
# [sdk] optional: DeepEval / Verifier "judge" model
ANTHROPIC_API_KEY=
# [sdk] optional: fallback LLM + embeddings provider
OPENAI_API_KEY=

# --- AI Perception Layer (vision/) ---
# torchxrayvision weight id for the DenseNet-121 backbone. Falls back to a
# randomly-headed timm densenet121 if it can't be fetched (offline / no cache).
VISION_WEIGHTS_ID=densenet121-res224-all     # [app]
VISION_INPUT_SIZE=224                        # [app]
# [app] blank = ~/.torchxrayvision
VISION_CACHE_DIR=

CLASSIFIER_CHECKPOINT_PATH=./models/checkpoints/pneumonet_cxr_v2_3.pt   # [app]
DETECTOR_CHECKPOINT_PATH=./models/checkpoints/detector_frcnn_r50.pt     # [app]

DETECTOR_SCORE_THRESHOLD=0.5         # [app]
DETECTOR_NMS_IOU_THRESHOLD=0.4       # [app]
DETECTOR_MAX_DETECTIONS=10           # [app]

GRADCAM_OUTPUT_DIR=./data/processed/gradcam  # [app]
# Calibration temperature is NOT a settings value -- it is fit and persisted
# by evaluation/calibration.py's TemperatureScaler (models/temperature.json).

# --- RAG / Evidence Sources ---
# [app] optional: raises the public rate limit
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1   # [app]
GUIDELINES_DIR=./data/guidelines     # [app] scripts/ingest_guidelines.py downloads here

# --- Vector Store (FAISS) ---
FAISS_INDEX_DIR=./vectorstore/faiss_index    # [app]
FAISS_INDEX_NAME=medagent_guidelines         # [app]
# [app] Shared HMAC-SHA256 secret: rag/ingest.py signs the index with it,
# rag/vectorstore.py verifies before trusting it. Required wherever a real
# (non-sample) index is loaded. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FAISS_SIGNING_KEY=
# --- Datasets ---
# Real RSNA data, populated by:  python3 scripts/ingest_real_rsna.py
# Point at ./data/synthetic_rsna to evaluate against generated data instead --
# the Model Card detects which and watermarks itself accordingly.
RSNA_DATA_DIR=./data/rsna            # [app]
SPLITS_DIR=./data/splits             # [app]

# --- Human-in-the-Loop / Orchestration ---
CHECKPOINT_DB_PATH=checkpoints.db    # [app] LangGraph checkpointer (resumable interrupts)

# --- Audit Trail (security/audit_logger.py) ---
# Append-only, hash-chained clinical audit log. Verify its integrity with:
#   python3 -m medagent.security.audit_logger
AUDIT_LOG_PATH=./data/audit_log.jsonl        # [app]

# --- MCP / PACS bridge (Phase 3 item 1) ---
# The NitroStack MCP server is a separate Node process the agent speaks to
# over STDIO (src/medagent/integration/mcp_client.py). Build it first:
#   cd mcp_server && npm install && npm run build
# Paths are resolved against the repo root unless absolute.
MCP_SERVER_DIR=mcp_server            # [app]
MCP_SERVER_COMMAND=node              # [app]
MCP_SERVER_ENTRYPOINT=dist/index.js  # [app]
# Ceiling on a PACS lookup -- an unanswered query must not hang a case.
MCP_TIMEOUT_SECONDS=30               # [app]

# --- Experiment Tracking / Evaluation ---
MLFLOW_TRACKING_URI=./mlruns                 # [sdk] read by mlflow from os.environ
MLFLOW_EXPERIMENT_NAME=medagent-hackathon    # [sdk]
# [sdk] only for Confident AI cloud sync
DEEPEVAL_API_KEY=

# --- UI (Streamlit) ---
# The primary console is the React app served by the FastAPI backend
# (uvicorn medagent.api.server:app); these apply only to the Streamlit entrypoint.
STREAMLIT_SERVER_PORT=8501           # [sdk]
STREAMLIT_SERVER_ADDRESS=0.0.0.0     # [sdk]
