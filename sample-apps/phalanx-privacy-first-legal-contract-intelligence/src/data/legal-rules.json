  "methodology": {
    "principles": [
      "Entity handling is selected by document type and legal purpose, not a blanket list.",
      "Data minimization: only redact or anonymize entities that are personal data or confidentiality-sensitive in that contract context.",
      "Legal interpretation fields needed for downstream clause risk analysis are preserved where lawful.",
      "Counsel approval is mandatory before production enforcement."
    ],
    "conflictResolution": "Most restrictive action wins: remove_metadata > redact > anonymize > preserve"
  },
