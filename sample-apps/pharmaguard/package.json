{
  "name": "pharmaguard-mcp",
  "version": "1.0.0",
  "description": "OSINT Drug Safety & Recall Intelligence MCP server",
  "main": "dist/index.js",
  "bin": {
    "pharmaguard-mcp": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build:widgets": "nitrostack-cli build",
    "build": "npm run build:widgets",
    "start": "node dist/index.js",
    "dev": "npm run build:widgets && npx tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npx tsx src/tests/smoke-test.ts"
  },
  "dependencies": {
    "@nitrostack/core": "^1.0.14",
    "@nitrostack/widgets": "^1.0.8",
    "recharts": "^2.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
