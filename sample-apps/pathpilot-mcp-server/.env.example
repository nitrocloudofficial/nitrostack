# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# PathPilot — GitHub + LinkedIn Skill Evidence MCP Server
# Optional: Set GitHub token to raise rate limits from 60/hour to 5000/hour
# Do NOT commit real tokens. Use environment secrets in production.
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional: LinkedIn OAuth user token for real profile data (MVP uses demo profile if absent)
# LINKEDIN_TOKEN=

# Analysis budget tuning (optional — defaults match PRD)
# MAX_FILE_PATHS=80
# MAX_CONTENT_READS=25
# MAX_RETAINED_TEXT_KB=64
# CACHE_TTL_SECONDS=300

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
