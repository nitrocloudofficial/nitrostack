# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# =============================================================================
# VeriCite — Scholarly Providers
# =============================================================================
# IMPORTANT: save this file with LF line endings. A CRLF .env puts a trailing
# carriage return inside every value; interpolated into an HTTP header that
# throws "Invalid character in header content" and Crossref fails on 100% of
# requests. VeriCite strips control characters defensively, but fix the file.
#
# CONTACT_EMAIL places requests in the Crossref/OpenAlex "polite pool" (higher
# rate limits, better reliability). Use a real, monitored address. Placeholder
# values such as your_email@domain.com are detected and ignored — VeriCite then
# sends no contact at all, because a fake address is worse than anonymous.
CONTACT_EMAIL=

# GROQ_API_KEY powers the LLM claim-support verdict (llama-3.3-70b-versatile),
# the step that decides SUPPORTED / CONTRADICTED / NOT_ENOUGH_EVIDENCE from a
# paper's abstract. Free key: https://console.groq.com
# Without it, verification still resolves citations across all three providers
# but cannot judge support, and every claim degrades to NOT_ENOUGH_EVIDENCE.
GROQ_API_KEY=

# SEMANTIC_SCHOLAR_API_KEY is optional. The unauthenticated tier is rate
# limited to roughly 100 requests / 5 min and returns HTTP 429 under load;
# the engine degrades to Crossref + OpenAlex when that happens.
# Free key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# VERICITE_OFFLINE=true serves evidence from recorded fixtures in
# src/modules/audit/evidence-fixtures.ts instead of calling Crossref/OpenAlex.
# Use for tests, CI, air-gapped runs, and demos where network is unreliable.
# Fixture-derived evidence is labelled provider "Fixture" throughout the report
# and sets AuditReport.offlineMode = true, so results are never passed off as live.
# VERICITE_OFFLINE=false

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
