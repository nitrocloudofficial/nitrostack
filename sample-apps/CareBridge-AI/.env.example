# CareBridge AI - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Firebase Configuration
FIREBASE_DATABASE_URL=your_firebase_database_url
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json

# OR use Application Default Credentials (for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# NitroStack Configuration
NITROSTACK_API_KEY=nsk_live_your_api_key_here
NITROSTACK_SERVER_URL=https://carebridge-ai.nitrocloud.app

# Get these values from:
# 1. NitroCloud: Settings → API Keys (copy nsk_live_... key)
# 2. NitroCloud: Your App → Overview → Service URL (copy base URL)

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=logs.json

# Optional: CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database Backup
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
