# Application
NODE_ENV=development
PORT=3002
NITROSTACK_PORT=3002
NITROSTACK_STUDIO_PORT=3000
NITROSTACK_WIDGET_PORT=3001
LOG_LEVEL=info
DEMO_SCENARIO=risky
# Optional override. Defaults to fixtures locally and dist/fixtures in production.
APIGUARD_FIXTURES_DIR=

# Evidence source
USE_LIVE_GITHUB=false
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
DEMO_GITHUB_OWNER=YOUR_GITHUB_ORG_OR_USER
DEMO_GITHUB_REPOSITORIES=react-consumer,python-consumer,go-consumer
GITHUB_MAX_REQUESTS=40
GITHUB_MAX_MATCHES_PER_QUERY=2
GITHUB_CACHE_TTL_SECONDS=300

# GitHub writes are disabled unless this flag and an exact repository allow-list
# are both set. Use only disposable repositories for live verification.
APIGUARD_GITHUB_WRITE_ENABLED=false
APIGUARD_WRITABLE_REPOSITORIES=owner/repository
FIX_BRANCH_PREFIX=apiguard

# Bounded LLM classifier
USE_LLM=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_MS=30000
LLM_MAX_EVIDENCE_ITEMS=8
LLM_MAX_SNIPPET_CHARS=1200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Declared demo identity, not authenticated enterprise identity
DEMO_ACTOR_ID=judge-demo
DEMO_ACTOR_DISPLAY_NAME=Hackathon Judge

# Remote smoke test
DEPLOYED_SERVICE_URL=
DEPLOYED_MCP_URL=
