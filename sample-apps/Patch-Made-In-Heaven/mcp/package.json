{
  "name": "patch-made-in-heaven-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patch Made In Heaven - Execution-Verified MCP Server",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:search-quality": "vitest run tests/quality",
    "seed": "tsx src/scripts/seed-elastic.ts",
    "seed:validate": "tsx src/scripts/verify-seeds.ts --validate-only",
    "seed:verify": "tsx src/scripts/verify-seeds.ts",
    "widget": "npm --prefix src/widgets"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1",
    "diff": "^9.0.0",
    "dotenv": "^16.3.1",
    "e2b": "^2.36.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "author": "",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
