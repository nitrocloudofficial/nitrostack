{
  "name": "patch-made-in-heaven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patch Made In Heaven - Execution-Verified AI Agent Memory & Search Platform",
  "main": "mcp/dist/index.js",
  "scripts": {
    "dev": "npm --prefix mcp run dev",
    "build": "npm --prefix mcp run build && node -e \"fs.cpSync('mcp/dist', 'dist', { recursive: true }); fs.copyFileSync('mcp/nitro.config.ts', 'nitro.config.ts');\"",
    "start": "nitrostack-cli start",

    "test": "npm --prefix mcp run test",
    "typecheck": "npm --prefix mcp run typecheck",
    "deploy": "cd mcp && npx @nitrostack/cli deploy"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1",
    "diff": "^9.0.0",
    "dotenv": "^16.3.1",
    "e2b": "^2.36.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "mcp",
    "web"
  ],

  "engines": {
    "node": ">=20"
  },
  "author": "",
  "license": "Apache-2.0"
}
