# Server Ports & CORS
PORT=5000
FRONTEND_URL=http://localhost:8080
JWT_SECRET=your_jwt_secret_key_here

# GitHub Personal Access Token (for vulnerability fixes, scope: repo)
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# Database
MONGO_URI=mongodb://localhost:27017/vulnixai

# AI Scanner Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_here

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
