  "private": true,
  "type": "module",
  "description": "MENTOR — shows a student when their build stopped matching their design, and refuses to write the fix",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
