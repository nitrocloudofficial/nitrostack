# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# =============================================================================
# Auditor Zero
# =============================================================================
# Required for semantic contradiction/disappearance detection and severity scoring.
ANTHROPIC_API_KEY=sk-ant-xxxx-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# HMAC key that seals the Black Box decision ledger. Held only by the server, so a
# tampered record cannot be re-sealed without it. Keep it STABLE across restarts,
# or previously sealed ledgers won't verify.
LEDGER_SECRET=replace-with-a-long-random-secret

# Allows the dev-only tamper endpoint even when NODE_ENV=production. Keep false in real deployments.
ALLOW_TAMPER_DEMO=false
