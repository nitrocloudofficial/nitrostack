# ==============================================================================
# RemitWise AI – Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the backend directory (or create frontend/.env)
# NEVER commit your populated `.env` file or private API secrets to git!

# ------------------------------------------------------------------------------
# 1. Backend Server Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS Security Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for web clients
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. LLM & Multi-Agent Planning Configuration
# ------------------------------------------------------------------------------
# Active LLM Provider option: "ollama" (default local), "openai", or "mock"
LLM_PROVIDER=ollama

# Ollama Local LLM Settings (Default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI Settings (Optional fallback / alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM Generation Parameters
TEMPERATURE=0.0
MAX_TOKENS=500
TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 4. External Data Sources & API Endpoints
# ------------------------------------------------------------------------------
# Frankfurter Live Foreign Exchange API
FRANKFURTER_BASE_URL=https://api.frankfurter.app
HTTP_TIMEOUT_SECONDS=5
CACHE_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# 5. Frontend UI Environment Variables (stored in frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
