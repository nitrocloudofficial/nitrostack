{
  "name": "instant-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "InstantPulse — AI business onboarding and credit pre-screening MCP server. Bank connection, explainable risk scoring and Stripe onboarding in seconds instead of days.",
  "scripts": {
    "dev": "nitrostack-cli dev",
