# =============================================================================
# InstantPulse — configuration
#
# Every provider below is OPTIONAL. With nothing configured the server runs the
# full pipeline against a local deterministic generator and marks results
# `simulated: true`. Add credentials to talk to the real sandbox APIs.
# =============================================================================

# NitroStack
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# -----------------------------------------------------------------------------
# Plaid — Sandbox only
# Get these from https://dashboard.plaid.com -> Developers -> Keys (Sandbox).
# No real money and no real financial data is ever involved.
# -----------------------------------------------------------------------------
# PLAID_CLIENT_ID=
# PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# -----------------------------------------------------------------------------
# Stripe — TEST MODE ONLY
# The server refuses to start onboarding with a live key (sk_live_...) to avoid
# creating a real connected account against a real business identity.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_ONBOARDING_RETURN_URL=https://example.com/instantpulse/onboarding/complete
# STRIPE_ONBOARDING_REFRESH_URL=https://example.com/instantpulse/onboarding/refresh

# -----------------------------------------------------------------------------
# InstantPulse
# -----------------------------------------------------------------------------
# Where application records and the audit trail are persisted.
# INSTANTPULSE_DATA_DIR=./data

# Shared secret required to override a credit decision. Leave unset in a demo
# and the override tool runs open; set it and review_override_decision requires
# a matching `officerToken`.
# INSTANTPULSE_OFFICER_TOKEN=

# -----------------------------------------------------------------------------
# Transport
# MCP_TRANSPORT_TYPE: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# -----------------------------------------------------------------------------
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
