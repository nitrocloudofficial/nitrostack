{
  "name": "medlens-mcp",
  "version": "0.1.0",
  "description": "MedLens MCP server: openFDA + RxNorm tools for drug regulatory, safety, generic-mapping, cost-signal, condition search, and reminder scheduling.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:widget && tsc -p tsconfig.json",
    "build:widget": "esbuild widget/entry.tsx --bundle --format=iife --jsx=automatic --outfile=dist-widget/medlens.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:stdio": "node dist/server.js --transport=stdio",
    "start:http": "node dist/server.js --transport=http --port=3333"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
