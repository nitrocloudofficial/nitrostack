{
  "name": "aegis-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aegis is an AI agent security platform that analyzes the combined capabilities of MCP-connected tools to detect dangerous attack paths, capability escalation, and data exfiltration risks before deployment.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "keywords": [
    "nitrostack",
    "mcp",
    "ai-security",
    "agent-permissions",
    "widgets"
  ],
  "author": "Prince Rai",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "groq-sdk": "^1.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
