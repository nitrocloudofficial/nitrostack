# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# SMTP (for sending patient notification emails and report sharing)
# For Gmail use app password and SMTP server smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_USER to the sender email (example prefilled with provided address)
SMTP_USER=veeraraghavan.manage@gmail.com
# SMTP_PASS must be set to your SMTP password / app password
SMTP_PASS=

# Twilio (for SMS OTP delivery). Provide account credentials to enable real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+919965204120

# Optional: enable dev mode to return OTP in tool responses even when SMS is configured
DEV_SHOW_OTP=true

# Do NOT store this file in source control. Copy to .env and fill secrets before running.
