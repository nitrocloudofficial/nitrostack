{
  "name": "nutripulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NutriPulse MCP server",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/data/build-catalog.ts && tsx src/data/build-users.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "author": "Hackathon Team",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
