# QuantGuard MCP Environment Configuration

# Server
NODE_ENV=development
PORT=3000

# Market Data Provider
# Options: yahoo (default, free), polygon (premium), alphavantage (free tier)
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=your_market_data_api_key_here

# News API
# Options: newsapi (free tier), finnhub (free tier)
NEWS_API_KEY=your_news_api_key_here

# Binance WebSocket (optional, for live crypto data)
# Default: wss://stream.binance.com:9443/ws
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Database
# SQLite database file path (relative to project root)
DATABASE_PATH=./quantguard.db

# Logging
LOG_LEVEL=info
