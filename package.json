{
  "name": "aegis-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aegis Protocol",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "seed:neo4j": "npx tsx scripts/seed-neo4j.ts",
    "verify:mocks": "node node_modules/tsx/dist/cli.mjs scripts/verify-mock-data.ts",
    "trigger:random": "node node_modules/tsx/dist/cli.mjs scripts/trigger-random.ts",
    "demo:safe": "node scripts/trigger.mjs safe",
    "demo:medium": "node scripts/trigger.mjs medium",
    "demo:critical": "node scripts/trigger.mjs critical",
    "demo:stream": "node scripts/stream_logs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "tsx": "^4.23.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "Kernel Guardians",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
