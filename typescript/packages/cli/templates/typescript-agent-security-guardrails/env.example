# Set these in your shell or in your NitroCloud environment settings. Every variable is optional in the demo profile.

# demo | production. Production refuses the file store, demo tokens and missing secrets.
GUARDRAILS_PROFILE=demo
PORT=3100
HOST=127.0.0.1
# GUARDRAILS_ADMIN_PORT=3101          # control plane; default PORT+1

# Policy store. Pick one; nothing set = local files in SECURITY_STATE_DIR (.security).
# MONGODB_URI=mongodb://localhost:27017/security?replicaSet=rs0   # npm install mongodb
# DATABASE_URL=postgres://user:pass@localhost:5432/security       # npm install pg
# GUARDRAILS_STORE=file                # file | memory | mongodb | postgres (override detection)

# Identity, tried in this order. Demo tokens (demo-research-admin, ...) work alongside real ones.
# GUARDRAILS_IDENTITY=demo,jwt,api-key
# OIDC_ISSUER=https://your-tenant.auth0.com/
# OIDC_AUDIENCE=https://security.example.com
# OIDC_JWKS_URL=                       # default <issuer>/.well-known/jwks.json
# GUARDRAILS_TENANT_CLAIM=org_id       # claim holding the team id
# GUARDRAILS_ADMIN_SCOPE=guardrails:admin
# API keys: <sha256 of key>:<team>:<agent|admin>[:principal], comma separated.
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" my-key
# GUARDRAILS_API_KEYS=

# Control plane and webhooks. Generated into .security/ in the demo profile.
# GUARDRAILS_ADMIN_API_KEY=
# GUARDRAILS_WEBHOOK_SECRET=           # comma separated to rotate
# GUARDRAILS_WEBHOOK_MODE=invalidate   # invalidate | activate

# Policy cache
# GUARDRAILS_CACHE_TTL_MS=30000
# GUARDRAILS_MAX_STALE_MS=300000       # serve last known good this long if the store is down
# GUARDRAILS_POLL_MS=2000              # head poll for database stores (backs up push)
