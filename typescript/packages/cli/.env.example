# PostHog — NITROSTACK_POSTHOG_KEY is optional (override; default built-in public project key in the CLI)
# NITROSTACK_POSTHOG_KEY=
NITROSTACK_POSTHOG_HOST=https://us.i.posthog.com

# Telemetry: set to 0 to opt out (along with DO_NOT_TRACK=1)
NITROSTACK_TELEMETRY=

# Session (see NitroStack CLI docs)
NITRO_TOKEN=
NITRO_API_URL=
NITRO_CLOUD_URL=
